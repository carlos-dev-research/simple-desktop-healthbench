# =====================================================================
# simple-desktop-healthbench: Flutter desktop (macOS / Windows / Linux)
#
# COMMIT these (they keep builds reproducible):
#   pubspec.yaml, pubspec.lock, .fvmrc, analysis_options.yaml,
#   macos/Runner/*.entitlements, .vscode/settings.json
#   (no CocoaPods: macOS plugins come through Swift Package Manager)
# =====================================================================

# ---------------------------------------------------------------------
# Secrets & credentials: never commit
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets.*
*.secret
*.secrets
api_key*
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore
key.properties
*.mobileprovision
*.provisionprofile
*.certSigningRequest
.netrc
# Apple signing / notarization credentials and local Xcode overrides (e.g. DEVELOPMENT_TEAM)
AuthKey_*.p8
*.xcconfig.local
**/Configs/Local.xcconfig
# Firebase / Google config files (contain project keys)
google-services.json
GoogleService-Info.plist

# ---------------------------------------------------------------------
# HealthBench data & local run output
# ---------------------------------------------------------------------
# Dataset files are downloaded separately (they carry a canary string).
healthbench/
*.jsonl.gz
# Runs live in the app's sandbox container, not in the repo. This is a safety
# net for runs exported or copied here by accident (they contain model output).
results/

# ---------------------------------------------------------------------
# Dart / Flutter
# ---------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.g.dart.tmp
# Symbolication / obfuscation output
app.*.symbols
app.*.map.json
*.dSYM/
*.dSYM.zip

# FVM: the SDK link is per-machine; .fvmrc (the pinned version) IS committed
.fvm/

# ---------------------------------------------------------------------
# macOS (Xcode / CocoaPods)
# ---------------------------------------------------------------------
macos/Flutter/ephemeral/
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Pods/
macos/.symlinks/
**/xcuserdata/
*.xcuserstate
**/DerivedData/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.xcarchive

# ---------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------
windows/flutter/ephemeral/
windows/flutter/generated_plugin_registrant.*
windows/flutter/generated_plugins.cmake
*.user
*.suo
*.VC.db
*.VC.opendb
.vs/

# ---------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------
linux/flutter/ephemeral/
linux/flutter/generated_plugin_registrant.*
linux/flutter/generated_plugins.cmake

# ---------------------------------------------------------------------
# Editors & OS files
# ---------------------------------------------------------------------
# VS Code: share only project settings, launch configs and recommended extensions
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.idea/
*.iml
*.ipr
*.iws
*.swp
*~
.DS_Store
._*
Thumbs.db
desktop.ini

# Logs & temp files (may contain request details)
*.log
*.tmp
*.temp
tmp/

# Command-line tools for building simple-desktop-healthbench on macOS.
# Installed by tool/setup.sh (preview first, no upgrades or cleanup of other tools).
# Xcode itself is not here: install it from the Mac App Store.
#
# Deliberately NOT listed:
#   cocoapods  Flutter >= 3.44 uses Swift Package Manager for macOS plugins.
#              Homebrew's cocoapods also links ruby and openssl@4 into PATH,
#              which would shadow /usr/bin/ruby and the existing openssl.

brew "fvm"   # Flutter Version Management (homebrew-core). Adds `fvm` and `dartaotruntime` only.
